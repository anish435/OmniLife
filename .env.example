# Copy to .env (git-ignored) and fill in. Never commit real values.
# Run with: flutter run --dart-define-from-file=.env   (see docs/assistant.md)

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Overrides the default model (llama-3.3-70b-versatile).
GROQ_MODEL=

# Optional. Base URL of a memory service; leave empty to keep memory on-device.
AI_MEMORY_URL=
