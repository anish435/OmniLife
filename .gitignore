app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Environment and secrets: never commit real credentials
.env
.env.*
!.env.example
*.secrets.json
android/key.properties
*.keystore
*.jks
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
serviceAccountKey.json
**/*serviceAccountKey*.json

# Firebase local cache only (firebase.json and .firebaserc are tracked)
.firebase/
firebase-debug.log
firestore-debug.log

